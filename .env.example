# Web3Forms access key for the contact form.
# This key is exposed to the browser by design (NEXT_PUBLIC_*) — Web3Forms
# access keys are client-side identifiers, not secrets. It is kept out of
# source so it can be rotated without a code change if it gets abused.
# Get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=
