# Web3Forms key for the contact form.
#
# NOTE the absence of a NEXT_PUBLIC_ prefix. This is read at runtime by the
# route handler at src/app/api/contact/route.ts and is never sent to the
# browser, so it is a real secret — keep it out of source and out of the
# client bundle.
#
# Because it is runtime-only, rotating it needs a restart, not a rebuild.
# Get one at https://web3forms.com
WEB3FORMS_KEY=
